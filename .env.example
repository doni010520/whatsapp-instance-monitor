# URL base da sua API uazapiGO (sem barra no final)
BASE_URL=https://sua-api.exemplo.com

# Token de administrador (usado para listar todas as instâncias)
ADMIN_TOKEN=seu_admin_token_aqui

# Token da instância que vai ENVIAR os alertas no WhatsApp
# (deve ser uma instância sempre conectada, usada só para notificações)
ALERT_TOKEN=token_da_instancia_que_envia_alertas

# Número de WhatsApp que vai RECEBER os alertas
# Formato: DDI + DDD + número, sem +, espaços ou traços
ALERT_PHONE=5511999999999

# Intervalo entre verificações em milissegundos
# 300000 = 5 minutos (padrão)
CHECK_INTERVAL_MS=300000

# Fuso horário para exibição de horários nas mensagens de alerta
TZ=America/Sao_Paulo

# Porta do servidor de health-check interno (padrão: 3000)
PORT=3000
